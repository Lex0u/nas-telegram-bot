{
  "name": "nas-telegram-bot",
  "version": "1.0.0",
  "description": "Bot Telegram de monitoring et contrôle pour NAS (températures disques, Docker, historique, alertes proactives)",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "setup": "tsx src/cli/setup.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lex0u/nas-telegram-bot.git"
  },
  "author": "Lexou",
  "license": "MIT",
  "keywords": [
    "telegram-bot",
    "raspberry-pi",
    "nas",
    "docker",
    "monitoring"
  ],
  "dependencies": {
    "@lex0u/logger": "^2.0.3",
    "chart.js": "^4.4.7",
    "chartjs-node-canvas": "^5.0.0",
    "@clack/prompts": "^0.9.1",
    "dockerode": "^4.0.3",
    "dotenv": "^16.4.5",
    "node-cron": "^4.6.0",
    "telegraf": "^4.16.3",
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/dockerode": "^3.3.32",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.4"
  }
}
